# Kopieren Sie diese Datei zu .env und tragen Sie Ihre Zugangsdaten ein.
# Die .env-Datei wird NICHT in Git eingecheckt (siehe .gitignore).

# Ihre E-Mail-Adresse bei Kleinanzeigen.de
KLEINANZEIGEN_EMAIL=ihre.email@beispiel.de

# Ihr Passwort bei Kleinanzeigen.de
KLEINANZEIGEN_PASSWORT=IhrPasswort

# Ihr Anthropic API-Schlüssel (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...
